# Public Supabase browser credentials only. Never put a service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only credentials for sending sign-in codes without changing shared auth templates.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=StartupsAfrica <signin@your-verified-domain.example>

# Canonical site URL and public legal contact details.
SITE_URL=https://startupsafrica.summit88.co.za
LEGAL_ENTITY_NAME=startupsSA
PRIVACY_CONTACT_EMAIL=central@summit88.co.za
