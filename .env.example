# Public Supabase browser credentials only. Never put a service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only credentials for sending sign-in codes without changing shared auth templates.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Startup SA <signin@your-verified-domain.example>

# Public launch configuration, read on the server. Keep PUBLIC_LAUNCH false until legal details are ready.
SITE_URL=https://startups.summit88.co.za
LEGAL_ENTITY_NAME=startupsSA
PRIVACY_CONTACT_EMAIL=central@summit88.co.za
PUBLIC_LAUNCH=false
# Enables consent-gated Analytics and Speed Insights; enable both in Vercel first.
VERCEL_ANALYTICS_ENABLED=false
